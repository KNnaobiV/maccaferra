# Django Site & Security
DJANGO_SECRET_KEY=your_secret_key_here
DEBUG=False
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
DJANGO_ADMIN_URL=admin/
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173

# Database (PostgreSQL)
POSTGRES_DB=site_management_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Email Configuration (SMTP)
# For production or testing live emails, set your SMTP provider credentials:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=ConstroPal <your_email@gmail.com>

# For development without SMTP (emails logged to terminal):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
